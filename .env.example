# DATABASE_URL 크리덴셜은 POSTGRES_* 와 동일 값으로.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=
REDIS_URL=
RABBITMQ_URL=
JWT_SECRET=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# 구글 로그인. 프론트 VITE_GOOGLE_CLIENT_ID 와 동일 값(ID 토큰 검증용).
GOOGLE_CLIENT_ID=
# 데모 계정 로그인 허용 여부. 화이트리스트(buyer@solde.demo, owner@solde.demo)만 통과하므로 prod=1 안전.
DEV_LOGIN=
# 콤마 구분 허용 origin. prod 예: https://solde.co.kr,https://www.solde.co.kr
CORS_ORIGINS=
# 업로드 이미지 저장 경로. compose 에서 uploads 볼륨으로 마운트됨.
UPLOAD_DIR=uploads

# Traefik Let's Encrypt 인증서 발급 알림용 이메일(docker-compose.prod.yml).
ACME_EMAIL=
